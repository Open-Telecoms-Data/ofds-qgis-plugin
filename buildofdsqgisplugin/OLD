                    FOREIGN KEY (base_id) REFERENCES nodes(id),
                    FOREIGN KEY (related_id) REFERENCES codelist_open_nodeType(id)
                );
CREATE TABLE relation_nodes_technologies (
                    base_id INTEGER NOT NULL,
