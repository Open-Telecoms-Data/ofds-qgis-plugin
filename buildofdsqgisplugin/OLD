                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "title" text,"description" text,"url" text,"format" integer,"network_id" integer,"contract_id" integer,FOREIGN KEY (format) REFERENCES codelist_open_mediaType(id),FOREIGN KEY (network_id) REFERENCES networks(id),FOREIGN KEY (contract_id) REFERENCES contracts(id)
            );
CREATE TABLE codelist_open_nodeType (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        code TEXT,
                        description TEXT
                    );
INSERT INTO codelist_open_nodeType VALUES(1,'addDropSite','Add drop site: A point at which individual digital bit streams can be added to, or dropped from, a multiplexed signal in order to redirect bit streams between network paths.');
INSERT INTO codelist_open_nodeType VALUES(2,'aggregationPoint','Aggregation point: A point at which multiple fibre optic cables are spliced together. Typically located between an exchange or POP and GPON splitters or end user premises.');
INSERT INTO codelist_open_nodeType VALUES(3,'borderCrossing','Border crossing: The point at which a fibre cable crosses either an international boundary or the coastline of the operator’s country. The countries to which this node connects should be listed in `.internationalConnections`.');
INSERT INTO codelist_open_nodeType VALUES(4,'cabinet','Cabinet: An distribution cabinet to which end users are connected by a standard phone line.');
INSERT INTO codelist_open_nodeType VALUES(5,'cableLanding','Cable landing point: The location where a submarine or other underwater cable makes landfall.');
INSERT INTO codelist_open_nodeType VALUES(6,'dataCentre','Data centre: A structure, or group of structures, dedicated to the centralized accommodation, interconnection and operation of information technology and network telecommunications equipment.');
INSERT INTO codelist_open_nodeType VALUES(7,'exchange','Exchange: A telephone exchange.');
INSERT INTO codelist_open_nodeType VALUES(8,'ixp','Internet Exchange Point: A physical point at which networks such as internet service providers, mobile operators and content delivery networks come together to connect and exchange internet traffic.');
INSERT INTO codelist_open_nodeType VALUES(9,'pop','Point of Presence: A demarcation point, access point, or physical location at which two or more networks or communication devices share a connection.');
INSERT INTO codelist_open_nodeType VALUES(10,'repeaterSite','Repeater site: A point at which fibre optic signals are amplified or repeated. Also known as a regeneration facility.');
INSERT INTO codelist_open_nodeType VALUES(11,'substation','Substation: An electrical substation.');
INSERT INTO codelist_open_nodeType VALUES(12,'tower','Tower: A ground-based or rooftop structure that supports antennas for sending or receiving radio waves.');
CREATE TABLE codelist_open_nodeTechnologies (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        code TEXT,
                        description TEXT
                    );
INSERT INTO codelist_open_nodeTechnologies VALUES(1,'ip','Internet Protocol: A network layer protocol that defines the addressing mechanism on the Internet to allow data to be transmitted.');
INSERT INTO codelist_open_nodeTechnologies VALUES(2,'mpls','Multi-Protocol Label Switching: A routing technique that directs data from one node to the next based on labels rather than network addresses.');
