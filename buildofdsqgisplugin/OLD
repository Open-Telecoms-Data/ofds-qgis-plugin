CREATE TABLE networks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "ofds_id" text,"name" text,"website" text,"publisher__name" text,"publisher__identifier__id" text,"publisher__identifier__scheme" integer,"publisher__identifier__legalName" text,"publisher__identifier__uri" text,"publicationDate" text,"collectionDate" text,"accuracy" real,"accuracyDetails" text,"language" integer,FOREIGN KEY (publisher__identifier__scheme) REFERENCES codelist_open_organisationIdentifierScheme(id),FOREIGN KEY (language) REFERENCES codelist_open_language(id)
            );
CREATE TABLE nodes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                geom BLOB NULL,
                "ofds_id" text,"name" text,"phase" integer,"status" text,"address__streetAddress" text,"address__locality" text,"address__region" text,"address__postalCode" text,"address__country" text,"accessPoint" text,"power" text,"physicalInfrastructureProvider" integer,"network_id" integer,FOREIGN KEY (phase) REFERENCES phases(id),FOREIGN KEY (physicalInfrastructureProvider) REFERENCES organisations(id),FOREIGN KEY (network_id) REFERENCES networks(id)
            );
CREATE TABLE spans (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                geom BLOB NULL,
                "ofds_id" text,"name" text,"phase" integer,"status" text,"readyForServiceDate" text,"start" integer,"end" integer,"directed" text,"physicalInfrastructureProvider" integer,"supplier" integer,"deploymentDetails__description" text,"darkFibre" text,"fibreType" text,"fibreTypeDetails__fibreSubtype" text,"fibreTypeDetails__description" text,"fibreCount" integer,"fibreLength" real,"capacity" real,"capacityDetails__description" text,"network_id" integer,FOREIGN KEY (phase) REFERENCES phases(id),FOREIGN KEY (start) REFERENCES nodes(id),FOREIGN KEY (end) REFERENCES nodes(id),FOREIGN KEY (physicalInfrastructureProvider) REFERENCES organisations(id),FOREIGN KEY (supplier) REFERENCES organisations(id),FOREIGN KEY (network_id) REFERENCES networks(id)
            );
CREATE TABLE phases (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "ofds_id" text,"name" text,"description" text,"network_id" integer,FOREIGN KEY (network_id) REFERENCES networks(id)
            );
CREATE TABLE organisations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "ofds_id" text,"name" text,"identifier__id" text,"identifier__scheme" integer,"identifier__legalName" text,"identifier__uri" text,"country" text,"roleDetails" text,"website" text,"logo" text,"network_id" integer,FOREIGN KEY (identifier__scheme) REFERENCES codelist_open_organisationIdentifierScheme(id),FOREIGN KEY (network_id) REFERENCES networks(id)
            );
CREATE TABLE codelist_open_contractType (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        code TEXT,
                        description TEXT
                    );
INSERT INTO codelist_open_contractType VALUES(1,'ppp','Public Private Partnership (PPP): A long-term contract between a private party and a government entity,for providing a public asset or service,in which the private party bears significant risk and management responsibility and remuneration is linked to performance.');
INSERT INTO codelist_open_contractType VALUES(2,'private','Private: A contract in which the private sector takes ownership of the network and responsibility for its operation.');
INSERT INTO codelist_open_contractType VALUES(3,'public','Public: A contract in which the public sector owns the network and is responsible for its operation.');
CREATE TABLE contracts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "ofds_id" text,"title" text,"description" text,"type" integer,"value__amount" real,"value__currency" text,"dateSigned" text,"network_id" integer,FOREIGN KEY (type) REFERENCES codelist_open_contractType(id),FOREIGN KEY (network_id) REFERENCES networks(id)
            );
CREATE TABLE nodes_internationalConnections (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                
                "streetAddress" text,"locality" text,"region" text,"postalCode" text,"country" text,"network_id" integer,"node_id" integer,FOREIGN KEY (network_id) REFERENCES networks(id),FOREIGN KEY (node_id) REFERENCES nodes(id)
            );
