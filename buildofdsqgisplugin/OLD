                        description TEXT
                    );
INSERT INTO codelist_closed_transmissionMedium VALUES(1,'coaxial','Coaxial cable: The physical media of this span is coaxial cable.');
INSERT INTO codelist_closed_transmissionMedium VALUES(2,'copper','Copper wire: The physical media of this span is copper wire.');
INSERT INTO codelist_closed_transmissionMedium VALUES(3,'fibre','Fibre optic cable: The physical media of this span is fibre optic cable.');
INSERT INTO codelist_closed_transmissionMedium VALUES(4,'microwave','Microwave radio: The physical media of this span is microwave radio.');
CREATE TABLE codelist_closed_deployment (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        code TEXT,
                        description TEXT
                    );
INSERT INTO codelist_closed_deployment VALUES(1,'aboveGround','Above ground: This span is deployed above ground. For example, aerial deployment along poles or using optical groundwire.');
INSERT INTO codelist_closed_deployment VALUES(2,'belowGround','Below ground: This span is deployed below ground. For example, cable that is routed through a duct buried in a trench or run through a sewer.');
CREATE TABLE codelist_open_spanTechnologies (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        code TEXT,
                        description TEXT
                    );
INSERT INTO codelist_open_spanTechnologies VALUES(1,'dwdm','Dense Wavelength Division Multiplexing: A technology that multiplexes a number of optical carrier signals onto a single optical fibre by using different wavelengths.');
INSERT INTO codelist_open_spanTechnologies VALUES(2,'sdh','Synchronous Digital Hierarchy: A standardised protocol for transferring multiple digital bit streams synchronously over optical fibre. SDH is used worldwide, with the exception of the US and Canada.');
INSERT INTO codelist_open_spanTechnologies VALUES(3,'sonet','Synchronous Optical Networking: A standardised protocol for transferring multiple digital bit streams synchronously over optical fibre. SONET is used in the US and Canada.');
INSERT INTO codelist_open_spanTechnologies VALUES(4,'tdm','Time Division Multiplexing: A technology that multiplexes a number of optical carrier signals onto a single optical fibre by using different arrival times.');
